{
  "name": "@routestack/react-widget",
  "version": "0.1.0",
  "private": true,
  "description": "Embeddable React travel search component",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx src/server.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@tailwindcss/vite": "^4.2.4",
    "concurrently": "^9.1.2",
    "dompurify": "^3.4.1",
    "dotenv": "^16.4.7",
    "lucide-react": "^1.11.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.2.4"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.7"
  }
}
