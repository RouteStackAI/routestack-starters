# RouteStack
ROUTESTACK_API_KEY=your-routestack-api-key
ROUTESTACK_API_SECRET=your-routestack-api-secret
ROUTESTACK_MCP_URL=https://mcp.routestack.ai/sse

# Webhook forwarding
FORWARD_URL=https://your-webhook-endpoint.com/events

# Event filter (comma-separated, leave empty for all events)
# EVENT_FILTER=booking.confirmed,booking.cancelled,price.changed

# Retry config (optional)
# MAX_RETRIES=3
# RETRY_DELAY_MS=1000
# FORWARD_TIMEOUT_MS=10000

# MCP connect resilience (optional)
# MCP_CONNECT_RETRIES=8
# MCP_CONNECT_RETRY_DELAY_MS=1000

# DEV mode - synthetic events (optional)
# DEV_FAKE_EVENTS=false
# DEV_FAKE_EVENTS_INTERVAL_MS=5000

# Polling fallback mode (optional)
# If MCP notifications are silent, this can call an MCP tool periodically
# MCP_POLLING_FALLBACK=false
# MCP_POLL_INTERVAL_MS=15000
# MCP_POLL_TOOL_NAME=list_events
# MCP_POLL_TOOL_ARGS={"limit":20}
# MCP_POLL_RESULT_EVENTS_PATH=events

# Logging (optional): debug | info | warn | error
# LOG_LEVEL=info
