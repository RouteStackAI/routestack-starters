ROUTESTACK_API_KEY=your_api_key_here
ROUTESTACK_API_SECRET=your_api_secret_here
ROUTESTACK_MCP_URL=https://mcp.routestack.ai/sse

# Optional: comma-separated field paths to extract numeric price from MCP response
MCP_PRICE_FIELD_PATH=price,ourprice,totalPrice,fare.total,data.price

# Optional: MCP tool name used for price lookup
MCP_PRICE_TOOL_NAME=flight_search

# JSON array of route objects
# Example:
# ROUTE_CONFIG_JSON=[{"id":"jfk-lhr","origin":"JFK","destination":"LHR","departureDate":"2026-07-01","adults":1,"cabinClass":"economy","currency":"USD","thresholdPercent":5}]
ROUTE_CONFIG_JSON=

# Email notification via Resend
RESEND_API_KEY=your_resend_key_here
NOTIFICATION_EMAIL=you@example.com
NOTIFICATION_FROM_EMAIL=onboarding@resend.dev
