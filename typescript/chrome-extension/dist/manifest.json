{
  "manifest_version": 3,
  "name": "RouteStack Travel Agent",
  "version": "0.1.0",
  "description": "AI travel agent that reads page context and suggests flights, hotels, and cars via RouteStack.",
  "permissions": ["sidePanel", "activeTab", "storage", "tabs"],
  "icons": {
    "16": "icons/RouteStack.ai_favicon-64px-on-black.png",
    "32": "icons/RouteStack.ai_favicon-64px-on-black.png",
    "48": "icons/RouteStack.ai_favicon-64px-on-black.png",
    "128": "icons/RouteStack.ai_favicon-64px-on-black.png"
  },
  "host_permissions": [
    "<all_urls>",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "https://api.mistral.ai/*",
    "https://*.routestack.ai/*"
  ],
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/extractor.js"]
    }
  ],
  "action": {
    "default_title": "RouteStack Travel Agent",
    "default_icon": {
      "16": "icons/RouteStack.ai_favicon-64px-on-black.png",
      "32": "icons/RouteStack.ai_favicon-64px-on-black.png"
    }
  }
}
