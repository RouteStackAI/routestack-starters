# RouteStack MCP Server
ROUTESTACK_API_KEY=your_api_key_here
ROUTESTACK_API_SECRET=your_api_secret_here
ROUTESTACK_MCP_URL=https://mcp.routestack.ai/sse

# LLM provider config
LLM_PROVIDER=openai
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gpt-4.1-mini
# Optional for mistral
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# Email (for approval notifications)
RESEND_API_KEY=your_resend_key_here
RESEND_FROM_EMAIL=your@domain.com

# App URL for deep links
APP_BASE_URL=http://localhost:3000

# Deep Link signing
JWT_SECRET=your_jwt_secret_here
PORT=3000
